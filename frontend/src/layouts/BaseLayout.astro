---
import "@/styles/global.css";
const { title = "Rate My CSD" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-background text-foreground">
      <div class="min-h-screen flex flex-col animate-in fade-in duration-500">
        <div class="flex-1">
          <slot />
        </div>
        <footer class="border-t py-6 text-center text-xs font-bold text-muted-foreground">
          Powered by Lazaritis Team
        </footer>
      </div>
  </body>
</html>
